[
  {
    "name": "task_plan",
    "description": "Hand a part of your to-do to a worker: each task starts a new coding Agent at once, beneath your to-do, with no card for the owner. Workers belong to your to-do only: role=worker on every task, todo_id only for a piece of your to-do (part_of it) with no Agent yet, no handing work on, at most 8 of your workers open at a time. Give each worker machine and cwd (computer and project directory): you run in a home directory, and a worker without them starts there. Give it done_when (results you can check); a task that only reads sets readonly true, gets the read-only constraint in its first message and is an independent check of another worker's result. Claude-family launchers always start in bypassPermissions; Codex read-only tasks keep the plan-mode sandbox. What a worker reports, and when it stops, stalls, runs past its estimate or waits for review, reaches you in a message starting \"Persona · supervision\". Returns at once with each worker's to-do; it does not confirm the Agent started.",
    "input_schema": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "title",
              "prompt",
              "role",
              "readonly"
            ],
            "additionalProperties": false,
            "properties": {
              "todo_id": {
                "type": "string",
                "description": "a piece of your to-do with no Agent yet; omitted: a new worker to-do"
              },
              "title": {
                "type": "string",
                "description": "the worker's task in a short line"
              },
              "prompt": {
                "type": "string",
                "description": "the worker's first message: all it needs, without asking you"
              },
              "role": {
                "type": "string",
                "enum": [
                  "worker"
                ],
                "description": "required: worker; a worker cannot hand work on"
              },
              "machine": {
                "type": "string",
                "description": "machine id: where the worker works; empty: the computer you run on"
              },
              "machine_policy": {
                "type": "string",
                "enum": [
                  "fixed",
                  "flexible"
                ],
                "description": "fixed (default) keeps the machine; flexible: a failed launcher health check may move it"
              },
              "cwd": {
                "type": "string",
                "description": "project directory, absolute or ~/…; empty: your own directory (no project)"
              },
              "launcher": {
                "type": "string",
                "description": "launcher name, one that machine has; empty: the default"
              },
              "model": {
                "type": "string",
                "description": "model id; empty: the launcher's default"
              },
              "tier": {
                "type": "string",
                "description": "an Agent preset (a tier of the model profile); explicit launcher, model, effort and speed override it"
              },
              "speed": {
                "type": "string",
                "enum": [
                  "standard",
                  "fast",
                  "ultrafast"
                ],
                "description": "speed; overrides the tier; standard/omitted: launcher default. Codex: fast, ultrafast; Claude Code: fast only"
              },
              "effort": {
                "type": "string",
                "description": "explicit effort override; omit to use the tier's"
              },
              "permission": {
                "type": "string",
                "enum": [
                  "bypassPermissions",
                  "plan"
                ],
                "description": "Writable mode. TRAE and Ferry take bypassPermissions and effort; omp takes neither."
              },
              "readonly": {
                "type": "boolean",
                "description": "true when the worker only reads and changes no project files; false when it changes files"
              },
              "done_when": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string"
                },
                "description": "what done means: results the worker must show, one each; the worker is told them"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "criterion": {
                      "type": "integer"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "arg": {
                      "type": "string"
                    }
                  }
                },
                "description": "hub-run checks on done_when, by number: kind pr_merged, ci_green or deployed"
              },
              "goal": {
                "type": "string",
                "description": "a read-only worker's goal in one sentence (a writable one needs done_when); estimates are automatic"
              },
              "expect_minutes": {
                "type": "integer",
                "minimum": 0,
                "description": "optional minutes override; omit/0 for comparable history or the 60-minute system_default. Review at 1×; stuck at 1.5× (min 20m); overdue at 3× (min 24h)"
              },
              "why": {
                "type": "string",
                "description": "optional: one line on why this machine and directory"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "task_review",
    "description": "Review a direct worker of your to-do. accepted (outcome done) closes verified work: one met check with evidence per done_when, by number or text. rework needs a concrete gap. Repeated or omitted rework kinds cap at two stalled rounds; substantive ones at ten. needs_user sends a decision up (reason, recommend). cancelled closes an unwanted one.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the worker's task id"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "accepted",
            "rework",
            "needs_user",
            "cancelled"
          ]
        },
        "verify": {
          "type": "boolean",
          "description": "run the hub's declared checks again; no verdict"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "done"
          ]
        },
        "rework_kind": {
          "type": "string",
          "enum": [
            "external_input",
            "substantive_new",
            "repeated_error",
            "low_roi_edge"
          ],
          "description": "rework, optional: external_input (outside input; skips the stalled cap), substantive_new (new defect after the gap was fixed; resets it), repeated_error/low_roi_edge (default)"
        },
        "note": {
          "type": "string",
          "description": "rework: what is missing, written to the worker; accepted and cancelled: one line of why"
        },
        "checks": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "met"
            ],
            "additionalProperties": false,
            "properties": {
              "number": {
                "type": "integer"
              },
              "criterion": {
                "type": "string",
                "description": "one of the task's done_when"
              },
              "met": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string",
                "description": "what shows it, or what is missing"
              }
            }
          },
          "description": "each done_when with whether it is met, and the evidence"
        },
        "reason": {
          "type": "string",
          "description": "needs_user: one sentence on what is to be decided"
        },
        "recommend": {
          "type": "string",
          "description": "needs_user: the option you recommend"
        }
      }
    }
  },
  {
    "name": "agent_read",
    "description": "Read the recent exchanges of one of your workers' Agent: what it was told, what it said, and its tool calls in short form. Use it before you review a worker (check its evidence yourself), to see why it stopped or what it waits for, and before you message it. todo_id is the worker's to-do, as its supervision message and task_plan's answer name it; turns is how many recent exchanges (default 2, at most 10). It reaches your own workers only.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the worker's to-do id"
        },
        "turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "how many recent exchanges; omitted: 2"
        }
      }
    }
  },
  {
    "name": "agent_send",
    "description": "Send a message to one of your open workers' Agent: the answer to its question, a nudge to finish or to report, what is still missing, \"continue\" with what was left after its turn was cut off or its computer restarted, or when to rebase and merge so the workers' changes go in one after another. A closed Agent is resumed by the message. It carries no new work: a new part of your to-do is a new worker (task_plan). It reaches your own workers only.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the worker's to-do id"
        },
        "text": {
          "type": "string",
          "description": "the message, for the worker to act on"
        }
      }
    }
  },
  {
    "name": "task_scope",
    "description": "Change a worker's criteria or expect_minutes after it started, or your own to-do's expect_minutes. Logged on the brief; the worker is not told (agent_send). Use add, drop and edit by number (an edit keeps its place) or done_when whole; a criterion is one result of at most 200 characters. Your own to-do's done_when is the main conversation's (report_to_supervisor, kind question). A step only the owner takes (deploying, merging, releasing, public sends, deleting, spending) is refused.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "change",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "a worker's to-do id, or your own (expect_minutes only)"
        },
        "change": {
          "type": "string",
          "description": "what changes, one sentence"
        },
        "why": {
          "type": "string"
        },
        "done_when": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "the whole list after the change"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "integer"
              },
              "kind": {
                "type": "string"
              },
              "arg": {
                "type": "string"
              }
            }
          },
          "description": "hub-run checks by number: pr_merged, ci_green or deployed"
        },
        "add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drop": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "edit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "expect_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "minutes it should take from now; 0: as it is"
        }
      }
    }
  }
]