[
  {
    "name": "resource_status",
    "description": "Read registered shared runners, queue tickets, duplicate markers and mirror freshness. An unknown or stale mirror is not a successful result.",
    "input_schema": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        }
      },
      "required": []
    },
    "defer_loading": true
  },
  {
    "name": "ask_user",
    "description": "Ask the user one or more multiple-choice questions in Persona (a card in this conversation plus a notification) and wait for the answers. Use it to confirm anything risky (sending messages / email for them, deleting, changing live systems) or to let them pick between options. Your runtime's own question tool does not reach the user; use this one. They can also type a free-form answer. Waits up to 2 hours; if the user writes in this conversation instead of picking an option, the question is withdrawn and the tool returns at once, with their message following. If nobody answers in time, the question becomes a to-do that waits for the user's call (in their to-do list and the next briefing), and their answer comes to this conversation later as a new message. With a deadline (each question then recommends one of its options): if nobody answers by it and you marked it reversible, the recommended options are taken by default and recorded on the question's to-do; one that cannot be undone is only reminded again and keeps waiting. With wait false the card goes up the same way but the call returns at once: end the turn without guessing the answer; it comes later as a new message quoting the question and the answer (or saying the card was closed unanswered, or expired and became a to-do). Use wait false only where your instructions say to; a confirmation this same turn needs (approving a message before it is sent) keeps the default. A waiting call holds this turn, so anything else sent to this conversation waits behind it: once such a message waits and the question has been up for a couple of minutes, the call returns without the answer and the card stays up as with wait false; end the turn then.",
    "input_schema": {
      "type": "object",
      "required": [
        "questions"
      ],
      "properties": {
        "wait": {
          "type": "boolean",
          "description": "default true: hold this turn until the user answers. false: put the card up and return at once; the answer arrives later as a new message in this conversation"
        },
        "deadline": {
          "type": "string",
          "description": "optional: until when the questions wait, a duration (\"30m\", \"4h\") or an RFC 3339 time, 1 minute to 30 days ahead; needs reversible and a recommend on every question"
        },
        "reversible": {
          "type": "boolean",
          "description": "with deadline: whether going ahead with the recommended options can be undone later. false for deleting, sending anything to other people, spending money or changing production: those are never taken by default"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "question",
              "options"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "header": {
                "type": "string",
                "description": "short label, ≤12 chars"
              },
              "multiSelect": {
                "type": "boolean"
              },
              "recommend": {
                "type": "string",
                "description": "the label of the option you recommend; required with deadline"
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "core_rank": 21
  },
  {
    "name": "notify_user",
    "description": "Send the user a notification right now (works when Persona is closed). Tapping it opens this conversation. Use for results of scheduled runs and anything time-sensitive; ordinary replies already notify. In the hub's push grading, a notice from a conversation other than the main one is held for the briefing instead of alerting unless it is P0; the tool answer then says it was moved to the briefing, so treat the user as not alerted.",
    "input_schema": {
      "type": "object",
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "push_level": {
          "type": "string",
          "enum": [
            "P0",
            "P1"
          ],
          "description": "How urgent this is. P1 (default): worth knowing; in the hub's push grading it is held for the briefing instead of alerting, and from a non-main conversation it is held even without an explicit level. P0: something the user must do or decide themselves (an action only they can take, a decision only they can make), so it alerts even in push grading and from any conversation. Use P1 for results, progress and conclusions."
        },
        "related_key": {
          "type": "string",
          "description": "Optional: what this is about, such as a PR link or a to-do id. In push grading the same key interrupts at most once in 12 hours, and held notices about it are listed together."
        }
      }
    },
    "core_rank": 37
  },
  {
    "name": "supervision_finish",
    "description": "Finish handling a supervision wake-up without cluttering the user's main conversation. Use visibility=\"silent\" when no user decision or useful result needs to be shown, with a short summary of what you checked or changed; then end the turn. The complete turn stays available in the expandable supervision record. Use visibility=\"user\" to explicitly show the turn without sending a notification. notify_user, ask_user, and task_review user conclusion cards also promote the turn. A promoted turn cannot be made silent again. This tool is only for supervision-triggered turns, not normal user messages.",
    "input_schema": {
      "type": "object",
      "required": [
        "visibility",
        "summary"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "silent",
            "user"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "core_rank": 6
  },
  {
    "name": "schedule_followup",
    "description": "Schedule a one-off reminder or follow-up (\"remind me at 15:00\", \"check again in an hour\", \"tell me when X finishes\") or work repeated on an interval (\"every 30 minutes\"); a time of day or week is a routine, not a follow-up. Example: {\"at\": \"1h\", \"title\": \"Login fix CI\", \"prompt\": \"Check whether CI on the login fix passed and tell the user\"}. At that time prompt comes back to this conversation (with new_conversation: true, to a conversation of its own), so make it self-contained. at takes RFC 3339 or 30m / 2h / 1d. To repeat, set every (5m to 7d) or a 5-field cron once and never schedule the next run yourself; check the next runs in the reply. Get the owner's consent before creating or changing recurring work.\n\nDetails: read .claude/skills/persona-work/references/schedules.md in your working directory.",
    "input_schema": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "repeats only: a supervised to-do this conversation advances; empty clears it"
        },
        "fresh_each_run": {
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "description": "when; with every, the first run (default: one interval from now)"
        },
        "every": {
          "type": "string",
          "description": "repeat this often, e.g. 30m"
        },
        "cron": {
          "type": "string",
          "description": "instead of at / every: minute hour day-of-month month day-of-week"
        },
        "prompt": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "new_conversation": {
          "type": "boolean"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (new default): each run's answer is pushed; asked: only what a run sends with notify_user"
        },
        "inbox": {
          "type": "string",
          "enum": [
            "off",
            "worthy",
            "every"
          ],
          "description": "only when the owner asked for Inbox rows"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "end of a repeat: RFC 3339 or 30m / 2h / 1d; null clears it"
        },
        "launcher": {
          "type": "string",
          "description": "its own launcher instead of Main chat's; needs new_conversation: true"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "core_rank": 38
  },
  {
    "name": "schedule_routine",
    "description": "Create or change recurring work at a time of day, week or month: \"every morning at 8\", \"weekdays at 18:00\". One-off and interval work is schedule_followup. Example: {\"title\": \"Morning briefing\", \"time\": \"08:00\", \"weekdays\": [1, 2, 3, 4, 5], \"prompt\": \"Tell the user what needs them today\"}. Each run opens its own conversation with prompt, so make it self-contained. Use time (with weekdays) or a 5-field cron, in the owner's time zone, and check the next runs in the reply. To change a routine, pass its id from list_followups and only the fields to change; enabled: false pauses it. Get the owner's consent before creating or changing recurring work.\n\nDetails: read .claude/skills/persona-work/references/schedules.md in your working directory.",
    "input_schema": {
      "type": "object",
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "a supervised to-do this conversation advances; empty clears it"
        },
        "fresh_each_run": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "description": "HH:MM, 24-hour"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "description": "1 = Monday … 7 = Sunday; omit for every day"
        },
        "cron": {
          "type": "string",
          "description": "instead of time: minute hour day-of-month month day-of-week, or @daily etc."
        },
        "enabled": {
          "type": "boolean"
        },
        "report": {
          "type": "boolean",
          "description": "a daily report that opens with Persona's north-star lines"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (new default): each run's answer is pushed; asked: only what a run sends with notify_user"
        },
        "inbox": {
          "type": "string",
          "enum": [
            "off",
            "worthy",
            "every"
          ],
          "description": "only when the owner asked for Inbox rows"
        },
        "run_if": {
          "type": [
            "object",
            "null"
          ],
          "description": "owner-approved shell check before each run: exit 0 runs, 1 skips; null removes it",
          "properties": {
            "command": {
              "type": "string",
              "maxLength": 4096
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 30
            },
            "on_error": {
              "type": "string",
              "enum": [
                "run",
                "skip"
              ],
              "default": "run"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "end: RFC 3339 or 30m / 2h / 1d; null clears it"
        },
        "launcher": {
          "type": "string",
          "description": "its own launcher instead of Main chat's; empty: Main chat's again"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "core_rank": 39
  },
  {
    "name": "schedule_state_set",
    "description": "Stage the recurring task's state note for this scheduled run. Call near the end of the run with the run key in the scheduled prompt and the full replacement state (up to 4096 UTF-8 bytes). Keep cursors, references, and what was already reported. The hub attempts to save the draft after confirming that the run succeeded. If it cannot track the run or write the note, later runs use the last saved note. An empty string clears the note when saved.",
    "input_schema": {
      "type": "object",
      "required": [
        "run_key",
        "text"
      ],
      "properties": {
        "run_key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "core_rank": 10
  },
  {
    "name": "delete_routine",
    "description": "Delete a scheduled task (routine or follow-up) by id (from list_followups). Confirm with the user first unless they asked for it.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "list_followups",
