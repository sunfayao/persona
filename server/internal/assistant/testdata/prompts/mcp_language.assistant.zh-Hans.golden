  {
    "name": "todo_get",
    "description": "Read a to-do's title/state, reminder and push status, timestamps, origin/plan, notes, agents, decisions and canonical repository/issue/PR associations. Maintain links with todo_repository_links_add or the revision-checked set tools; associations do not prove completion.",
    "input_schema": {
