[
  {
    "name": "ask_user",
    "description": "Ask the user multiple-choice questions on a card in Persona and wait for the answers. Use it to confirm anything risky (sending messages or email for them, deleting, changing live systems) or to let them choose. Your runtime's own question tool does not reach the user. Use wait false only where your instructions say to; a confirmation this turn needs (approving a message before it is sent) keeps the default.\n\nDetails: read .claude/skills/persona-work/references/ask-user.md in your working directory.",
    "input_schema": {
      "type": "object",
      "required": [
        "questions"
      ],
      "properties": {
        "wait": {
          "type": "boolean",
          "description": "false: put the card up and return at once; the answer comes later as a new message"
        },
        "deadline": {
          "type": "string",
          "description": "until when they wait: \"4h\" or an RFC 3339 time; needs reversible and a recommend on every question"
        },
        "reversible": {
          "type": "boolean",
          "description": "with deadline: whether taking the recommended options can be undone; false for deleting, sending to others, spending money or changing production"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "question",
              "options"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "header": {
                "type": "string",
                "description": "short label, ≤12 chars"
              },
              "multiSelect": {
                "type": "boolean"
              },
              "recommend": {
                "type": "string",
                "description": "the label of the option you recommend"
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "core_rank": 19
  },
  {
    "name": "notify_user",
    "description": "Send the user a notification right now (works when Persona is closed). Tapping it opens this conversation. Use for results of scheduled runs and anything time-sensitive; ordinary replies already notify. In the hub's push grading, a notice from a conversation other than the main one is held for the briefing instead of alerting unless it is P0; the tool answer then says it was moved to the briefing, so treat the user as not alerted.",
    "input_schema": {
      "type": "object",
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "push_level": {
          "type": "string",
          "enum": [
            "P0",
            "P1"
          ],
          "description": "How urgent this is. P1 (default): worth knowing; in the hub's push grading it is held for the briefing instead of alerting, and from a non-main conversation it is held even without an explicit level. P0: something the user must do or decide themselves (an action only they can take, a decision only they can make), so it alerts even in push grading and from any conversation. Use P1 for results, progress and conclusions."
        },
        "related_key": {
          "type": "string",
          "description": "Optional: what this is about, such as a PR link or a to-do id. In push grading the same key interrupts at most once in 12 hours, and held notices about it are listed together."
        }
      }
    },
    "core_rank": 29
  },
  {
    "name": "supervision_finish",
    "description": "Finish handling a supervision wake-up without cluttering the user's main conversation. Use visibility=\"silent\" when no user decision or useful result needs to be shown, with a short summary of what you checked or changed; then end the turn. The complete turn stays available in the expandable supervision record. Use visibility=\"user\" to explicitly show the turn without sending a notification. notify_user, ask_user, and task_review user conclusion cards also promote the turn. A promoted turn cannot be made silent again. This tool is only for supervision-triggered turns, not normal user messages.",
    "input_schema": {
      "type": "object",
      "required": [
        "visibility",
        "summary"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "silent",
            "user"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "core_rank": 6
  },
  {
    "name": "schedule_followup",
    "description": "Schedule a one-off reminder or follow-up (\"remind me at 15:00\", \"check again in an hour\", \"tell me when X finishes\") or work repeated on an interval (\"every 30 minutes\"); a time of day or week is a routine, not a follow-up. Example: {\"at\": \"1h\", \"title\": \"Login fix CI\", \"prompt\": \"Check whether CI on the login fix passed and tell the user\"}. At that time prompt comes back to this conversation (with new_conversation: true, to a conversation of its own), so make it self-contained. at takes RFC 3339 or 30m / 2h / 1d. To repeat, set every (5m to 7d) or a 5-field cron once and never schedule the next run yourself; check the next runs in the reply. Get the owner's consent before creating or changing recurring work.\n\nDetails: read .claude/skills/persona-work/references/schedules.md in your working directory.",
    "input_schema": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "repeats only: a supervised to-do this conversation advances; empty clears it"
        },
        "fresh_each_run": {
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "description": "when; with every, the first run (default: one interval from now)"
        },
        "every": {
          "type": "string",
          "description": "repeat this often, e.g. 30m"
        },
        "cron": {
          "type": "string",
          "description": "instead of at / every: minute hour day-of-month month day-of-week"
        },
        "prompt": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "new_conversation": {
          "type": "boolean"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (new default): each run's answer is pushed; asked: only what a run sends with notify_user"
        },
        "inbox": {
          "type": "string",
          "enum": [
            "off",
            "worthy",
            "every"
          ],
          "description": "only when the owner asked for Inbox rows"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "end of a repeat: RFC 3339 or 30m / 2h / 1d; null clears it"
        },
        "launcher": {
          "type": "string",
          "description": "its own launcher instead of Main chat's; needs new_conversation: true"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "core_rank": 30
  },
  {
    "name": "schedule_routine",
    "description": "Create or change recurring work at a time of day, week or month: \"every morning at 8\", \"weekdays at 18:00\". One-off and interval work is schedule_followup. Example: {\"title\": \"Morning briefing\", \"time\": \"08:00\", \"weekdays\": [1, 2, 3, 4, 5], \"prompt\": \"Tell the user what needs them today\"}. Each run opens its own conversation with prompt, so make it self-contained. Use time (with weekdays) or a 5-field cron, in the owner's time zone, and check the next runs in the reply. To change a routine, pass its id from list_followups and only the fields to change; enabled: false pauses it. Get the owner's consent before creating or changing recurring work.\n\nDetails: read .claude/skills/persona-work/references/schedules.md in your working directory.",
    "input_schema": {
      "type": "object",
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "a supervised to-do this conversation advances; empty clears it"
        },
        "fresh_each_run": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "description": "HH:MM, 24-hour"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "description": "1 = Monday … 7 = Sunday; omit for every day"
        },
        "cron": {
          "type": "string",
          "description": "instead of time: minute hour day-of-month month day-of-week, or @daily etc."
        },
        "enabled": {
          "type": "boolean"
        },
        "report": {
          "type": "boolean",
          "description": "a daily report that opens with Persona's north-star lines"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (new default): each run's answer is pushed; asked: only what a run sends with notify_user"
        },
        "inbox": {
          "type": "string",
          "enum": [
            "off",
            "worthy",
            "every"
          ],
          "description": "only when the owner asked for Inbox rows"
        },
        "run_if": {
          "type": [
            "object",
            "null"
          ],
          "description": "owner-approved shell check before each run: exit 0 runs, 1 skips; null removes it",
          "properties": {
            "command": {
              "type": "string",
              "maxLength": 4096
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 30
            },
            "on_error": {
              "type": "string",
              "enum": [
                "run",
                "skip"
              ],
              "default": "run"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "end: RFC 3339 or 30m / 2h / 1d; null clears it"
        },
        "launcher": {
          "type": "string",
          "description": "its own launcher instead of Main chat's; empty: Main chat's again"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "schedule_state_set",
    "description": "Stage the recurring task's state note for this scheduled run. Call near the end of the run with the run key in the scheduled prompt and the full replacement state (up to 4096 UTF-8 bytes). Keep cursors, references, and what was already reported. The hub attempts to save the draft after confirming that the run succeeded. If it cannot track the run or write the note, later runs use the last saved note. An empty string clears the note when saved.",
    "input_schema": {
      "type": "object",
      "required": [
        "run_key",
        "text"
      ],
      "properties": {
        "run_key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "core_rank": 10
  },
  {
    "name": "delete_routine",
    "description": "Delete a scheduled task (routine or follow-up) by id (from list_followups). Confirm with the user first unless they asked for it.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "list_followups",
    "description": "List every scheduled task (with ids): follow-ups that have not run yet, repeating ones, daily routines. A repeating task with an end time shows that time. Read it before changing, pausing or deleting one.",
    "input_schema": {
      "type": "object",
      "properties": {}
    },
    "defer_loading": true
  },
  {
    "name": "cancel_followup",
    "description": "Cancel a scheduled follow-up or a repeating task by id (from list_followups).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "machines_list",
    "description": "List computers' connection, system, resources, agents, launchers and their failures, node builds, and on Macs what computer use, the browser and the live screen can do now. Samples over 30 seconds old are stale. Nulls have reasons; do not infer or rank.",
    "input_schema": {
      "type": "object",
      "properties": {}
    },
    "core_rank": 9
  },
  {
    "name": "machine_redeploy",
    "description": "Redeploy by ID or exact name; return the confirmed outcome.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine"
      ],
      "properties": {
        "machine": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "machine_exec",
    "description": "Run one quick non-interactive shell command on an online computer through its Persona node; returns exit_code, stdout, stderr, timed_out and duration_ms. Multi-step or code work goes to task_plan or agent_send, and commands needing a password (sudo) to secret_run.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "command"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "id or name"
        },
        "command": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "description": "default ~"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "description": "default 20"
        }
      }
    },
    "core_rank": 18
  },
  {
    "name": "agents_list",
    "description": "The coding Agents on the user's computers (Claude Code, Codex, Antigravity, TRAE and runtime Agents) and their state: needs_you (waiting for an answer or approval), working, unread (finished, result not looked at), idle, offline (stopped). Much faster and more accurate than ssh + herdr. The default lists Active (needs you, working, finished unread), then Idle and Ended in the last 24 hours, newest first: look at those two before handing out follow-up work, since an Agent that did the related work on that computer and directory goes on in its own context (reuse= says how). Each line has machine, session id, project, title and last update, then its conclusion or last words. Do not reuse an Agent on a model the user retired (model=). Let one with ultracode=on finish its multi-agent workflow without nudging it. A line under an Agent waits for the user: answer a question with interaction_answer and its interaction id; an approval is the user's to give in the app. `kind: \"conversations\"` lists your own Persona conversations instead, newest activity first (id, title, last activity, main/running state, gist; this one marked; `query`, `include_archived`, `limit`): find the user's conversation there before reading or messaging it.\n\nDetails: read .claude/skills/persona-work/references/agents-and-machines.md in your working directory.",
    "input_schema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "needs_you",
            "working",
            "unread",
            "idle",
            "ended",
            "done",
            "muted",
            "archived",
            "all"
          ],
          "description": "default active (then idle and those that ended in the last 24 hours); ended = every stopped Agent; done = work finished in the last 24 hours; muted = the muted ones; archived = only archived sessions (agent_archive with restore brings one back), which the others leave out; all = everything, archived ones marked"
        },
        "machine": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "filter by title / project / directory; conversations: by title or last message"
        },
        "kind": {
          "type": "string",
          "enum": [
            "agents",
            "conversations"
          ],
          "description": "agents (default), or your Persona conversations"
        },
        "include_archived": {
          "type": "boolean",
          "description": "conversations: archived ones too, marked"
        },
        "limit": {
          "type": "integer",
          "description": "conversations: default 30, max 100"
        }
      }
    },
    "core_rank": 2
  },
  {
    "name": "agent_read",
    "description": "Read the recent conversation of one agent (from agents_list): the user's messages, what the agent said, tool calls in short form. `turns` = how many recent exchanges (default 2, max 10). Use it to answer the user's follow-ups about work an agent or task already did (its conclusion, a PR link, why it stopped) instead of asking the agent with agent_send, which makes it take another turn while the user waits (and a stopped agent takes no messages: it is read-only). With `conversation` instead of machine and session_id it reads another of your Persona conversations (from agents_list kind conversations), cut the same way.",
    "input_schema": {
      "type": "object",
      "properties": {
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        },
        "conversation": {
          "type": "string",
          "description": "a Persona conversation's id, or its first 8 characters, instead of machine and session_id"
        }
      }
    },
    "core_rank": 1
  },
  {
    "name": "agent_send",
    "description": "Send what the user asked for to a coding Agent. Follow-up on an Agent's own work (same computer and directory) goes to it as agents_list's reuse= says; unrelated work: agent_start; unsure: ask_user. Give task for new work, so you supervise it, and say its done_when in text too; omit task for a reply, nudge or decision.\n\n`wait_seconds` observes up to 50 seconds after dispatch, appending `Inline observation` JSON: `completed`(this input's `reply`), `question`(pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, with known input/session ids. Observation never answers questions, accepts tasks, resends or cancels work; normal supervision/`task_review` applies. Older nodes may time out instead of an unrelated reply.\n\nDetails: read .claude/skills/persona-work/references/agent-send.md in your working directory.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "text"
      ],
      "properties": {
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "0/omitted: normal receipt"
        },
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "resume": {
          "type": "boolean"
        },
        "resume_why": {
          "type": "string",
          "description": "shown to the user"
        },
        "dismiss_notice": {
          "type": "boolean"
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "files the owner gave in this chat, by absolute path"
        },
        "handoff": {
          "type": "object",
          "required": [
            "todo_id",
            "receiving_todo_id",
            "head",
            "check",
            "until"
          ],
          "additionalProperties": false,
          "properties": {
            "todo_id": {
              "type": "string"
            },
            "receiving_todo_id": {
              "type": "string"
            },
            "head": {
              "type": "string"
            },
            "check": {
              "type": "string"
            },
            "until": {
              "type": "string"
            }
          }
        },
        "task": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "description": "a short line (Simplified Chinese, under 20 characters)"
            },
            "done_when": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              },
              "description": "results you can check"
            },
            "expect_minutes": {
              "type": "integer"
            },
            "todo_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "core_rank": 8
  },
  {
    "name": "agent_switch",
    "description": "Move a running Claude Code agent (from agents_list) to another launcher on its computer and go on with it, in one step: the agent is quit and resumed on that launcher in the same terminal, with the same conversation, and `text` is sent to it there. It is the switch the user makes from the agent's chat. Use it only when the user asked for it, for example when a subscription's usage limit stopped agents and the user wants them to go on with another provider now rather than wait for the reset; never on your own. The launcher must be one of that computer's (machines_list and agents_list show the names). The switch happens now or not at all: an agent that is working, waits for the user (a question, a permission, a plan), is starting, has background work its quit would end, or has a draft or a dialog in its input box is refused with nothing typed and nothing left waiting; tell the user why, and try again once it has stopped if they still want it. Other refusals say why too (a launcher that does not run there or is not signed in, a model the launcher's default cannot be read for: give model). Not for stopped agents (agent_send with resume), assistant conversations, read-only agents, or Codex and other agents. An agent its usage limit stopped goes on with what it was doing when `text` is left out; any other agent needs `text`. Its usage-limit continuation, if one was due, is not sent afterwards. To move many Claude Code agents at once, leave out session_id: name them in `agents`, or leave it out for every Claude Code agent narrowed by `machine` and `from_launcher`; call it with `preview` true first and tell the user what it will do with each, then again once they agree (one call is enough when they named exactly which agents and where). Each goes as its state allows: an idle or limit-stopped one now, a working or waiting one when its turn ends (agents_list shows switch_queued=), a stopped one Persona started on its next resume; the answer has one line per agent.",
    "input_schema": {
      "type": "object",
      "required": [
        "launcher"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "launcher": {
          "type": "string",
          "description": "the launcher to move it to, by its name on that computer"
        },
        "model": {
          "type": "string",
          "description": "a model of that launcher; empty: the launcher's default"
        },
        "effort": {
          "type": "string",
          "description": "the reasoning effort on the new launcher; empty: as it is"
        },
        "text": {
          "type": "string",
          "description": "what the agent does on the new launcher, sent as the user would type it; empty only for an agent its usage limit stopped (it goes on with what it was doing)"
        },
        "agents": {
          "type": "array",
          "description": "the agents to move; empty: every Claude Code agent (running, or stopped and started by Persona) that machine and from_launcher keep",
          "items": {
            "type": "object",
            "required": [
              "session_id"
            ],
            "properties": {
              "machine": {
                "type": "string",
                "description": "the machine's id or name, as agents_list shows it"
              },
              "session_id": {
                "type": "string",
                "description": "the agent's session id, or its first 8 characters"
              }
            }
          }
        },
        "from_launcher": {
          "type": "string",
          "description": "without agents: only the agents running on this launcher (claude: the default)"
        },
        "preview": {
          "type": "boolean",
          "description": "true: only say what it would do with each agent; nothing is switched or queued"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "agent_interrupt",
    "description": "Stop what an agent (from agents_list) is doing right now, and optionally redirect it: its current turn is cut off (Esc in its terminal, or its runtime's cancel), the agent and its session stay, and `then` is sent to it at once as the user would type it. Use it when waiting is worse than stopping: it works in the wrong direction, waits in a loop (sleep, polling), repeats a failing step, collides with another agent, or the user said stop. To add a word to an agent that works fine, use agent_send instead (queued behind its turn). What it did already is not undone (files it changed, commands it ran): tell it in `then` what to put back. Not for assistant conversations, and not for agents that can only be read. A `then` of only /exit or /quit to an agent on a task another conversation supervises is refused, as agent_send refuses it: nothing is stopped or sent.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
