    "input_schema": {
      "type": "object",
      "properties": {}
    },
    "core_rank": 35
  },
  {
    "name": "cancel_followup",
    "description": "Cancel a scheduled follow-up or a repeating task by id (from list_followups).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "core_rank": 24
  },
  {
    "name": "machines_list",
    "description": "List computers' connection, system, resources, agents, launchers and their failures, node builds, and on Macs what computer use, the browser and the live screen can do now. Samples over 30 seconds old are stale. Nulls have reasons; do not infer or rank.",
    "input_schema": {
      "type": "object",
      "properties": {}
    },
    "core_rank": 9
  },
  {
    "name": "machine_redeploy",
    "description": "Redeploy by ID or exact name; return the confirmed outcome.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine"
      ],
      "properties": {
        "machine": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "agents_list",
    "description": "The coding Agents on the user's computers (Claude Code, Codex, Antigravity, TRAE and runtime Agents), with their state: needs_you (waiting for an answer / approval), working, unread (finished, result not looked at), idle, offline (stopped). The default view lists three groups: Active (needs you, working, finished unread); Idle (live and at rest, newest first); Ended in the last 24 hours (stopped, newest first). Look at the last two before handing out follow-up work: an Agent that already did the related work on that computer and directory goes on in its own context. done lists work finished in the last 24 hours, ended every stopped Agent newest first, all everything with what goes on first and then the latest, and muted the muted agents that would otherwise appear in the live snapshot. Each line has machine, session id, project, title and last update, and below it the conclusion or the last thing the agent said. launcher= and model= say what it runs on (with effort= when known; do not reuse an Agent on a model the user retired), context= how full its context is, todo= the to-do it works for, or its last one (closed), and reuse= how follow-up work goes on with it: agent_send (live), agent_send resume=true (stopped; stop= says why), or the owner's Resume only (the owner stopped it). usage_limit (with resets_at when the reset is known) marks one its subscription's usage limit stopped (agent_switch moves such an agent to another launcher when the user asks). Known Claude Code switch states appear as ultracode=on/off; an omitted state is unknown. ultracode=on means every substantive task runs a multi-agent dynamic workflow, independently of thinking effort. Let it finish and wait for workflow results without nudging it. Much faster and more accurate than ssh + herdr. At the end: the launchers that failed their last health check, by machine (agent_start and task_plan move off them).\n\nA line under an agent is something waiting for the user: a question lists its options and the interaction id to answer it with (interaction_answer), an approval is the user's to give in the app.",
    "input_schema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "needs_you",
            "working",
            "unread",
            "idle",
            "ended",
            "done",
            "muted",
            "archived",
            "all"
          ],
          "description": "default active = needs_you + working + unread, then idle and the ones that ended in the last 24 hours; ended = every stopped Agent, newest first; done = finished work in the last 24 hours; muted = muted agents in the live snapshot categories; archived: only the archived sessions (agent_unarchive restores them); the others leave archived ones out, all lists them marked archived"
        },
        "machine": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "filter by title / project / directory"
        }
      }
    },
    "core_rank": 2
  },
  {
    "name": "agent_read",
    "description": "Read the recent conversation of one agent (from agents_list): the user's messages, what the agent said, tool calls in short form. `turns` = how many recent exchanges (default 2, max 10). Use it to answer the user's follow-ups about work an agent or task already did (its conclusion, a PR link, why it stopped) instead of asking the agent with agent_send, which makes it take another turn while the user waits (and a stopped agent takes no messages: it is read-only).",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        }
      }
    },
    "core_rank": 1
  },
  {
    "name": "agent_send",
    "description": "Send what the user asked for to an Agent. A busy Agent may queue it. Follow-up work on what an Agent already did (same computer and directory: agents_list shows its reuse=) goes to that Agent in its own context instead of a new one. A stopped Agent needs resume and resume_why. Recorded non-user stops (including quota/capacity errors) allow resume; the main conversation, acting for the owner, also resumes an Agent that ended without the owner's Stop (exit, or unknown: it ended on its own). An owner's Stop (user) needs the owner's Resume. It must be supervised (give task with the follow-up's title and done_when unless on an open task of yours). A nearly full Agent is compacted first. For unrelated work use agent_start. Unsure: ask_user. An unstarted branch starts on its first message. Only /exit or /quit stops a running Agent and keeps the tab. The owner's controls close another conversation's Agent.\n\nFor dialog_open, retry with dismiss_notice only when Enter alone closes the notice. For permissions and pickers, tell the user or use interaction_answer.\n\nGive task to supervise new work, including done_when in text. More on your existing task keeps its title and updates its criteria. A different title, the user's own to-do or another conversation's task is refused. A failed send creates no task. Omit task for a reply, nudge or decision.\n\nUse `handoff` for an already-stopped to-do you supervise. A node acknowledgement starts its wait for the receiving Agent's result.\n\n`wait_seconds` observes up to 50 seconds after dispatch, appending `Inline observation` JSON: `completed`(this input's `reply`), `question`(pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, with known input/session ids. Observation never answers questions, accepts tasks, resends or cancels work; normal supervision/`task_review` applies. Older nodes may time out rather than return an unrelated reply.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "text"
      ],
      "properties": {
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "0/omitted: normal receipt"
        },
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "resume": {
          "type": "boolean",
          "description": "resume this stopped agent with its context on its own launcher, text as its first message"
        },
        "resume_why": {
          "type": "string",
          "description": "shown to the user"
        },
        "dismiss_notice": {
          "type": "boolean",
          "description": "Press Enter first to close a notice that only says \"Enter to continue\" (no options). Any other dialog still refuses the send."
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "absolute paths of pictures/files the user gave in this conversation (Claude Code path or app attachment); copied to the agent, appended to its message with mentions updated; others refused"
        },
        "handoff": {
          "type": "object",
          "required": [
            "todo_id",
            "receiving_todo_id",
            "head",
            "check",
            "until"
          ],
          "additionalProperties": false,
          "properties": {
            "todo_id": {
              "type": "string"
            },
            "receiving_todo_id": {
              "type": "string"
            },
            "head": {
              "type": "string",
              "description": "Full candidate commit ID"
            },
            "check": {
              "type": "string"
            },
            "until": {
              "type": "string",
              "description": "Duration or RFC 3339 deadline"
            }
          }
        },
        "task": {
          "type": [
            "object",
            "null"
          ],
          "description": "new work: make it your supervised task first (main or a lead); null for a reply",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "description": "the task in a short line (Simplified Chinese, under 20 characters)"
            },
            "done_when": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              },
              "description": "results you can check when it says it is done (a PR merged, a sheet's link, what the live system answers)"
            },
            "expect_minutes": {
              "type": "integer",
              "description": "how long it should take from now; longer without progress counts as stuck"
            }
          }
        }
      }
    },
    "core_rank": 8
  },
  {
    "name": "agent_switch",
    "description": "Move a running Claude Code agent (from agents_list) to another launcher on its computer and go on with it, in one step: the agent is quit and resumed on that launcher in the same terminal, with the same conversation, and `text` is sent to it there. It is the switch the user makes from the agent's chat. Use it only when the user asked for it, for example when a subscription's usage limit stopped agents and the user wants them to go on with another provider now rather than wait for the reset; never on your own. The launcher must be one of that computer's (machines_list and agents_list show the names). The switch happens now or not at all: an agent that is working, waits for the user (a question, a permission, a plan), is starting, has background work its quit would end, or has a draft or a dialog in its input box is refused with nothing typed and nothing left waiting; tell the user why, and try again once it has stopped if they still want it. Other refusals say why too (a launcher that does not run there or is not signed in, a model the launcher's default cannot be read for: give model). Not for stopped agents (agent_send with resume), assistant conversations, read-only agents, or Codex and other agents. An agent its usage limit stopped goes on with what it was doing when `text` is left out; any other agent needs `text`. Its usage-limit continuation, if one was due, is not sent afterwards.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "launcher"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "launcher": {
          "type": "string",
          "description": "the launcher to move it to, by its name on that computer"
        },
        "model": {
          "type": "string",
          "description": "a model of that launcher; empty: the launcher's default"
        },
        "effort": {
          "type": "string",
          "description": "the reasoning effort on the new launcher; empty: as it is"
        },
        "text": {
          "type": "string",
          "description": "what the agent does on the new launcher, sent as the user would type it; empty only for an agent its usage limit stopped (it goes on with what it was doing)"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "agents_switch",
    "description": "Move many Claude Code agents to another launcher on their computers in one call. Use it when the user asks to move agents to another launcher (\"move everything on the default launcher to X\", \"switch these to X\"), for example because they watch their subscription quota; never on your own. Name the agents in `agents`, or leave it out to take every Claude Code agent (running ones, and stopped ones Persona started), narrowed by `machine` and `from_launcher` (`claude` is the default launcher). First call it with `preview` true and tell the user what it will do with each agent, then call it again without `preview` once they agree; when the user already named exactly which agents and where, one call is enough. Each agent goes as its state allows: one its usage limit stopped is switched now and goes on with what it was doing; an idle one is switched now and nothing is sent (it waits on the new launcher for the next message); one that is working, waits for the user (a question, a permission, a plan), is starting or has background work is queued and switched when its turn ends (with the usage-limit continuation if that turn ended on a limit); a stopped one Persona started has the launcher it resumes on changed, so its next Resume, or the message that resumes it, comes up on the new launcher; one the checks refuse (another CLI, a runtime's session, an assistant conversation, a launcher that does not run there, a model the launcher's default cannot be read for: give model) is reported and left as it is, and so is one whose switch failed on its computer (it is back on its launcher; not tried again: tell the user why). The answer has one line per agent: switched and continued, switched, switched (takes effect when resumed), queued, or refused with why. A queued switch is dropped if the agent moves to another launcher meanwhile or after a day; if it stops meanwhile, its Resume is pointed at the new launcher instead; agents_list shows queued ones as switch_queued=. The switch is the same as the user's from the agent's chat: same conversation, same terminal.",
    "input_schema": {
      "type": "object",
      "required": [
        "launcher"
      ],
      "properties": {
        "launcher": {
          "type": "string",
          "description": "the launcher to move them to, by its name on their computers"
        },
        "model": {
          "type": "string",
          "description": "a model of that launcher; empty: the launcher's default"
        },
        "effort": {
          "type": "string",
          "description": "the reasoning effort on the new launcher; empty: as each has it"
        },
        "agents": {
          "type": "array",
          "description": "the agents to move; empty: every Claude Code agent (running, or stopped and started by Persona) that machine and from_launcher keep",
          "items": {
            "type": "object",
            "required": [
              "session_id"
            ],
            "properties": {
              "machine": {
                "type": "string",
                "description": "the machine's id or name, as agents_list shows it"
              },
              "session_id": {
                "type": "string",
                "description": "the agent's session id, or its first 8 characters"
              }
            }
          }
        },
        "machine": {
          "type": "string",
          "description": "without agents: only this computer's agents"
        },
        "from_launcher": {
          "type": "string",
          "description": "without agents: only the agents running on this launcher (claude: the default)"
        },
        "preview": {
          "type": "boolean",
          "description": "true: only say what it would do with each agent; nothing is switched or queued"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "agent_interrupt",
    "description": "Stop what an agent (from agents_list) is doing right now, and optionally redirect it: its current turn is cut off (Esc in its terminal, or its runtime's cancel), the agent and its session stay, and `then` is sent to it at once as the user would type it. Use it when waiting is worse than stopping: it works in the wrong direction, waits in a loop (sleep, polling), repeats a failing step, collides with another agent, or the user said stop. To add a word to an agent that works fine, use agent_send instead (queued behind its turn). What it did already is not undone (files it changed, commands it ran): tell it in `then` what to put back. Not for assistant conversations, and not for agents that can only be read. A `then` of only /exit or /quit to an agent on a task another conversation supervises is refused, as agent_send refuses it: nothing is stopped or sent.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "then": {
          "type": "string",
          "description": "the new instruction, sent right after it stopped; empty: just stop it"
        }
      }
    },
    "core_rank": 18
  },
  {
    "name": "agent_start",
    "description": "Start a coding Agent directly on one of the owner's computers, in a project directory, with a first prompt; returns its session id. Use it for development work the owner asked to start directly (planned, supervised work goes through task_plan), and check machines_list first. Claude-family launchers start in bypassPermissions. ultracode is for Claude Code only; pi and cursor ignore effort, and TRAE CLI and omp refuse it. secret_env maps environment variable names to secret-provider references such as op://vault/item/field, never to values: the owner approves the hand-off on a card first; tell the Agent the variables exist, and never ask it to print them.\n\n`wait_seconds` observes up to 50 seconds after dispatch, appending `Inline observation` JSON: `completed`(this input's `reply`), `question`(pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, with known input/session ids. Observation never answers questions, accepts tasks, resends or cancels work; normal supervision/`task_review` applies. Older nodes may time out rather than return an unrelated reply.\n\nDetails: read .claude/skills/persona-work/references/agent-start.md in your working directory.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "cwd",
        "prompt"
      ],
      "properties": {
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "0/omitted: normal receipt"
        },
        "machine": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "description": "absolute or ~/ path; with worktree, a directory of the repository to branch from"
        },
        "prompt": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "files the owner gave in this chat, by absolute path"
        },
        "launcher": {
          "type": "string"
        },
        "secret_env": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string"
          }
        },
        "ultracode": {
          "type": "boolean",
          "description": "Claude Code multi-agent workflow for a large task; slower and costlier"
        },
        "worktree": {
          "type": "object",
          "description": "a checkout of its own that the machine's engine makes (never have the Agent run git worktree add)",
          "required": [
            "branch"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "description": "made from the workspace's HEAD when new; one checked out elsewhere is refused"
            }
          }
        },
        "tier": {
          "type": "string",
          "description": "preset from the snapshot's Model profile line; explicit launcher, model, effort or speed override it"
        },
        "host": {
          "type": "string",
          "description": "agy (Antigravity companion) or an enabled engine"
        },
        "speed": {
          "type": "string",
          "enum": [
            "standard",
            "fast",
            "ultrafast"
          ],
          "description": "standard (default), fast or ultrafast speed; Claude Code: fast only"
        },
        "effort": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "core_rank": 19
  },
  {
    "name": "agent_supervise",
    "description": "Main can adopt an Agent on no open task for supervision and task_review. Omit role for a worker. A leader needs done_when and a non-work-trust computer. It gets instructions to plan and review direct workers, who cannot delegate. On your open task, use task_scope for done_when/expect_minutes.",
