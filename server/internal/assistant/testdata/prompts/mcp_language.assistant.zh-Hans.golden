    },
    "defer_loading": true
  },
  {
    "name": "todo_delete",
    "description": "Delete one of the user's Persona to-dos for good (its notes, links to agents and decisions go with it), only when the user asks for it to be deleted; one that is finished is completed instead (todo_complete). Every delete is confirmed in Persona first; if the user declines, writes instead, or does not answer, nothing is deleted. The agents that worked on it are left as they are.",
    "input_schema": {
      "type": "object",
      "required": [
