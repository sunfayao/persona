  {
    "name": "todo_list",
    "description": "List Persona to-dos (not Feishu tasks): open/failed starts by default, open first, then newest first. Returns id, title/state, project, reminder, agents and first note line; times use the user's time zone. Filter by the schema fields. Find an id here before edits; use todo_get for details.",
    "input_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done",
            "all"
          ],
          "description": "Default: open."
        },
        "with_agents": {
          "type": "boolean",
          "description": "true: with agents (tasks); false: user's own."
        },
        "query": {
          "type": "string",
          "description": "words to find in the title or notes"
        },
        "project": {
          "type": "string",
          "description": "Project label."
        },
        "kind": {
          "type": "string",
          "enum": [
            "todo",
            "concern"
          ],
          "description": "todo or user-raised concerns awaiting their reported outcome; omitted includes both."
        },
        "limit": {
          "type": "integer",
          "description": "Default 50; maximum 200."
        }
      }
    },
    "core_rank": 13
  },
  {
    "name": "todo_get",
    "description": "Read a to-do's title/state, reminder and push status, timestamps, origin/plan, notes, agents, decisions and canonical repository/issue/PR associations. Maintain links with todo_links (add_links, or the revision-checked set and set_links); associations do not prove completion.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    },
    "core_rank": 3
  },
  {
    "name": "todo_create",
    "description": "Record what the user asks to remember, track or be reminded of (`remind`), and agreed work, immediately and without confirmation; carry the work out via task_plan, linking its task to this to-do (`todo_id` or `part_of`). Open title duplicates return existing to-dos but refuse bindings: use todo_links get and set. Short title in the user's language; details in notes. Bindings save atomically; IDs/catalog_revision from repositories list. No files or task progress changes.",
    "input_schema": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "what is to be done, in a line, in the user's language"
        },
        "notes": {
          "type": "string",
          "description": "Details."
        },
        "remind": {
          "type": "string",
          "description": "Future reminder (user time zone/RFC3339 or relative 30m/2h/1d). Only when the user asks to be reminded."
        },
        "kind": {
          "type": "string",
          "enum": [
            "todo",
            "concern"
          ],
          "description": "todo (default); concern (main chat only) tracks a user-raised matter until its outcome is reported (todo_update); other completion tools cannot close it."
        },
        "project": {
          "type": "string",
          "description": "Project label; prefer long-term work. Only when clear; reuse an existing one, no near-duplicates."
        },
        "part_of": {
          "type": "string",
          "description": "Request to-do id this is a piece of; hand out via task_plan todo_id."
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "With part_of: sibling piece ids it waits for."
        },
        "repository_bindings": {
          "type": "object",
          "required": [
            "catalog_revision",
            "repositories"
          ],
          "properties": {
            "catalog_revision": {
              "type": "integer",
              "minimum": 0
            },
            "repositories": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "repo_id"
                ],
                "properties": {
                  "repo_id": {
                    "type": "string"
                  },
                  "directory_alias": {
                    "type": "string"
                  },
                  "requested_ref": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "default",
                          "branch",
                          "tag",
                          "commit",
                          "ref"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "default"
                          }
                        }
                      },
                      {
                        "required": [
                          "value"
                        ]
                      }
                    ]
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "issue",
                            "pull_request"
                          ]
                        },
                        "number": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,19}$"
                        },
                        "title": {
                          "type": "string",
                          "description": "Plain source title; trim; ≤1024 UTF-8 bytes.",
                          "maxLength": 1024
                        }
                      },
                      "additionalProperties": false,
                      "oneOf": [
                        {
                          "required": [
                            "url"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "kind"
                                ]
                              },
                              {
                                "required": [
                                  "number"
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "required": [
                            "kind",
                            "number"
                          ],
                          "not": {
                            "required": [
                              "url"
                            ]
                          }
                        }
                      ]
                    },
                    "maxItems": 50
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "core_rank": 15
  },
  {
    "name": "todo_update",
    "description": "Update supplied title, notes, reminder, project, part_of or after immediately, including task to-dos; no confirmation. Omitted fields stay; \"\" clears notes/remind/project/part_of, [] clears after. New reminder times notify again. `state`, alone: `done` once the user says so (confirmed in Persona first for a task's or one with agents, as it closes their idle agents; a concern needs `report`, the outcome you told the user), `open` if not done after all, `deleted` only when asked (confirmed; a finished one is done instead).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "To-do id from todo_list."
        },
        "title": {
          "type": "string",
          "description": "the new title"
        },
        "notes": {
          "type": "string",
          "description": "Replacement notes; retain anything still needed. \"\" clears."
        },
        "remind": {
          "type": "string",
          "description": "New reminder datetime (user's time zone/RFC3339) or relative 30m/2h/1d; never past. \"\" clears."
        },
        "project": {
          "type": "string",
          "description": "Project label, preferably a long-term work area. Set only when clear; reuse an existing one, do not invent near-duplicates. \"\" clears."
        },
        "part_of": {
          "type": "string",
          "description": "Request to-do this is a piece of; changing clears after."
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sibling piece ids it waits for; replaces old."
        },
        "state": {
          "type": "string",
          "enum": [
            "done",
            "open",
            "deleted"
          ],
          "description": "with id only"
        },
        "report": {
          "type": "string",
          "description": "a concern's outcome as you told the user (state done)"
        }
      }
    },
    "core_rank": 14
  },
