        },
        "title": {
          "type": "string",
          "description": "the new title"
        },
        "notes": {
          "type": "string",
          "description": "Replacement notes; retain anything still needed. \"\" clears."
        },
        "remind": {
          "type": "string",
          "description": "New reminder datetime (user's time zone/RFC3339) or relative 30m/2h/1d; never past. \"\" clears."
        },
        "project": {
          "type": "string",
          "description": "Project label, preferably a long-term work area. Set only when clear; reuse an existing one, do not invent near-duplicates. \"\" clears."
        },
        "part_of": {
          "type": "string",
          "description": "Request to-do this is a piece of; changing clears after."
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sibling piece ids it waits for; replaces old."
        }
      }
    },
    "core_rank": 14
  },
  {
    "name": "todo_complete",
    "description": "Mark one of the user's Persona to-dos done, when the user says it is done (or asks you to close it). The user's own to-do is closed at once. A task's, or one agents work on, is confirmed in Persona first, because closing it also closes its agents once they are idle; if the user declines, nothing changes. A concern is not closed with this: report its outcome with concern_report.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    },
    "defer_loading": true
  },
