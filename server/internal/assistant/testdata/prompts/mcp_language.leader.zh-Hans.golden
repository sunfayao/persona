[
  {
    "name": "task_plan",
    "description": "Hand a part of your to-do to a worker: each task starts a new coding Agent at once, beneath your to-do, with no card for the owner. Workers belong to your to-do only: every task sets role=worker, todo_id names only a piece of your to-do (part_of it) that has no Agent yet, a worker cannot hand work on, and at most 8 of your workers are open at a time. Give each worker machine and cwd, the computer and the project directory it works in: you run in a home directory, and a worker left without them starts there. Give it done_when (results you can check); a task that only reads sets readonly true and gets the read-only constraint in its first message, which makes it an independent check of another worker's result. Claude-family launchers always start in bypassPermissions mode; Codex read-only tasks keep the plan-mode sandbox. What a worker reports, and when it stops, stalls, runs past its estimate or waits for review, reaches you in a message that starts with \"Persona · supervision\". Returns at once, with each worker's to-do; it does not confirm the Agent started.",
    "input_schema": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "title",
              "prompt",
              "role",
              "readonly"
            ],
            "additionalProperties": false,
            "properties": {
              "todo_id": {
                "type": "string",
                "description": "a piece of your to-do with no Agent yet, to run this worker on; omitted: a new worker to-do"
              },
              "title": {
                "type": "string",
                "description": "the worker's task in a short line"
              },
              "prompt": {
                "type": "string",
                "description": "the worker's first message: everything it needs to do the work without asking you"
              },
              "role": {
                "type": "string",
                "enum": [
                  "worker"
                ],
                "description": "required: worker; a worker cannot hand work on"
              },
              "machine": {
                "type": "string",
                "description": "machine id: where the worker works; empty: the computer you run on"
              },
              "machine_policy": {
                "type": "string",
                "enum": [
                  "fixed",
                  "flexible"
                ],
                "description": "fixed (default): keep this machine; flexible: a failed launcher health check may move it to another computer"
              },
              "cwd": {
                "type": "string",
                "description": "the project directory: absolute path or ~/…; empty: your own directory, which is no project"
              },
              "launcher": {
                "type": "string",
                "description": "launcher name, one that machine has; empty: the default"
              },
              "model": {
                "type": "string",
                "description": "model id; empty: the launcher's default"
              },
              "tier": {
                "type": "string",
                "description": "an Agent preset (a tier of the model profile in use); explicit launcher, model, effort and speed override it"
              },
              "speed": {
                "type": "string",
                "enum": [
                  "standard",
                  "fast",
                  "ultrafast"
                ],
                "description": "new-start speed; explicit choice overrides the tier. standard/omitted: launcher default. Codex: fast, ultrafast; Claude Code: fast only"
              },
              "effort": {
                "type": "string",
                "description": "explicit effort override; omit to use the tier's"
              },
              "permission": {
                "type": "string",
                "enum": [
                  "bypassPermissions",
                  "plan"
                ],
                "description": "Writable mode. TRAE and Ferry take bypassPermissions and effort; omp takes neither."
              },
              "readonly": {
                "type": "boolean",
                "description": "true when the worker only reads (looks things up, reads code, changes no project files); false when it changes files. The first message automatically adds the read-only constraint. Claude-family launchers use bypassPermissions; Codex keeps its plan sandbox"
              },
              "done_when": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string"
                },
                "description": "what done means: results the worker must show, one each; the worker is told them"
              },
              "goal": {
                "type": "string",
                "description": "a read-only worker's goal: what you get from it, in one sentence (a writable worker needs done_when instead); estimates are automatic for both"
              },
              "expect_minutes": {
                "type": "integer",
                "minimum": 0,
                "description": "optional minutes override; omit/0 for comparable history or the 60-minute system_default. Review at 1×; stuck at 1.5× (min 20m); overdue at 3× (min 24h)"
              },
              "why": {
                "type": "string",
                "description": "optional: one line on why this machine and directory"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "task_review",
    "description": "Review a direct worker of your to-do. accepted with outcome done closes verified work: give one met check with nonblank evidence per current done_when. rework needs a concrete gap. Repeated or omitted rework kinds cap at two stalled rounds; substantive changes cap at ten total. needs_user sends a decision up with reason and recommendation. cancelled closes an unwanted worker.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the worker's task id, as the supervision message and task_plan's answer give it"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "accepted",
            "rework",
            "needs_user",
            "cancelled"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "done"
          ]
        },
        "rework_kind": {
          "type": "string",
          "enum": [
            "external_input",
            "substantive_new",
            "repeated_error",
            "low_roi_edge"
          ],
          "description": "rework, optional: external_input (external review/conflict/owner input; skips 2-round stalled cap), substantive_new (prior gap fixed, new defect found; resets stalled cap), repeated_error/low_roi_edge (default when omitted; cap 2 stalled, 10 total)"
        },
        "note": {
          "type": "string",
          "description": "rework: what is missing, written to the worker; accepted and cancelled: one line of why"
        },
        "checks": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "met"
            ],
            "additionalProperties": false,
            "properties": {
              "criterion": {
                "type": "string",
                "description": "one of the task's done_when"
              },
              "met": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string",
                "description": "what shows it, or what is missing"
              }
            }
          },
          "description": "each done_when with whether it is met, and the evidence"
        },
        "reason": {
          "type": "string",
          "description": "needs_user: one sentence on what is to be decided"
        },
        "recommend": {
          "type": "string",
          "description": "needs_user: the option you recommend"
        }
      }
    }
  },
  {
    "name": "agent_read",
    "description": "Read the recent exchanges of one of your workers' Agent: what it was told, what it said, and its tool calls in short form. Use it before you review a worker (check its evidence yourself), to see why it stopped or what it waits for, and before you message it. todo_id is the worker's to-do, as its supervision message and task_plan's answer name it; turns is how many recent exchanges (default 2, at most 10). It reaches your own workers only.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the worker's to-do id"
        },
        "turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "how many recent exchanges; omitted: 2"
        }
      }
    }
  },
  {
    "name": "agent_send",
    "description": "Send a message to one of your open workers' Agent: the answer to its question, a nudge to finish or to report, what is still missing, \"continue\" with what was left after its turn was cut off or its computer restarted, or when to rebase and merge so the workers' changes go in one after another. A closed Agent is resumed by the message. It carries no new work: a new part of your to-do is a new worker (task_plan). It reaches your own workers only.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the worker's to-do id"
        },
        "text": {
          "type": "string",
          "description": "the message, for the worker to act on"
        }
      }
    }
  },
  {
    "name": "task_scope",
    "description": "Change a worker's done_when or expect_minutes after it started, or the expect_minutes of your own to-do: when an estimate runs out (estimate_due, overdue) or what a worker must deliver changes. It is logged on the to-do's brief with what changes and why; the worker is not told, so send it the change with agent_send. Give done_when as the whole list after the change. Your own to-do's done_when is the main conversation's to change: ask it with report_to_supervisor (kind question). A step only the owner takes (deploying, merging, releasing, public sends, deleting, spending) is refused.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "change",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "a worker's to-do id, or your own to-do's (expect_minutes only)"
        },
        "change": {
          "type": "string",
          "description": "what changes, in a sentence the owner can read"
        },
        "why": {
          "type": "string"
        },
        "done_when": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "a worker's criteria as they are after the change, the whole list"
        },
        "expect_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "minutes it should take from now; 0: as it is"
        }
      }
    }
  }
]