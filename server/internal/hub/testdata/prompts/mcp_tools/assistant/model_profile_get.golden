{
  "name": "model_profile_get",
  "description": "Inspect one model profile by id. See its purpose bindings, launcher model fields and named execution tiers (the Agent presets). Add, change or remove a tier with persona_settings key model_profiles.tiers. Saving a tier does not apply the profile.",
  "input_schema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Profile id from model_profiles_list"
      }
    },
    "additionalProperties": false,
    "required": [
      "id"
    ]
  }
}
