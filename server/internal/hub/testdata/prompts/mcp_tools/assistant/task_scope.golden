{
  "name": "task_scope",
  "description": "Change a supervised task's work or what done means after it started (its todo id): adds a brief-log entry, applies the new criteria or expect_minutes and restarts overdue; the owner reads it in the next digest. It is the only way done_when changes after start. Use add, drop and edit by criterion number (an edit keeps its place, never a drop) or the whole done_when list (a criterion left out is logged as dropped), not both. A criterion is one checkable result of at most 200 characters. A change adding an owner-only step (deploying, merging, releasing, public sends, deleting, spending, production changes) is refused unless the owner's own message started this turn: ask first (ask_user, or task_review needs_user). Only its supervisor may call it; the Agent is not told: use agent_send. A finished task past the settle window with no owner card is refused: give task_review first. Details: persona-work references/task-review.md.",
  "input_schema": {
    "type": "object",
    "required": [
      "todo_id",
      "change",
      "why"
    ],
    "properties": {
      "todo_id": {
        "type": "string",
        "description": "the task's todo id (todo_…)"
      },
      "change": {
        "type": "string",
        "description": "what changes, in one sentence the owner can read (Simplified Chinese)"
      },
      "why": {
        "type": "string",
        "description": "why, in one sentence (Simplified Chinese)"
      },
      "done_when": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "string"
        },
        "description": "the whole list after the change; not with add, drop or edit"
      },
      "add": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "drop": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "edit": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "number",
            "text"
          ],
          "properties": {
            "number": {
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          }
        }
      },
      "expect_minutes": {
        "type": "integer",
        "minimum": 0,
        "description": "how long the task should take from now; leave it out (or 0) to keep it"
      }
    }
  }
}
