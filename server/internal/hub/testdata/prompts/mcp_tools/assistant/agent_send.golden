{
  "name": "agent_send",
  "description": "Send the user's request to a coding Agent. Follow-up on an Agent's own work goes to it as agents_list's reuse= says; unrelated work: agent_start; unsure: ask_user. Give task for new work, so you supervise it, and repeat its done_when in text; omit task for a reply, nudge or decision.\n\n`wait_seconds` observes up to 50 seconds after dispatch, appending `Inline observation` JSON: `completed`(this input's `reply`), `question`(pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, plus known ids. Observation never answers, accepts, resends or cancels; normal supervision/`task_review` applies. Older nodes may time out instead of an unrelated reply.\n\nDetails: .claude/skills/persona-work/references/agent-send.md in the working dir.",
  "input_schema": {
    "type": "object",
    "required": [
      "machine",
      "session_id",
      "text"
    ],
    "properties": {
      "wait_seconds": {
        "type": "integer",
        "minimum": 0,
        "description": "0: normal receipt"
      },
      "machine": {
        "type": "string"
      },
      "session_id": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "resume": {
        "type": "boolean"
      },
      "resume_why": {
        "type": "string",
        "description": "shown to the user"
      },
      "dismiss_notice": {
        "type": "boolean"
      },
      "attachments": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        },
        "description": "the owner's files, absolute paths"
      },
      "handoff": {
        "type": "object",
        "required": [
          "todo_id",
          "receiving_todo_id",
          "head",
          "check",
          "until"
        ],
        "additionalProperties": false,
        "properties": {
          "todo_id": {
            "type": "string"
          },
          "receiving_todo_id": {
            "type": "string"
          },
          "head": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "until": {
            "type": "string"
          }
        }
      },
      "task": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "a short line (Simplified Chinese, under 20 characters)"
          },
          "done_when": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            },
            "description": "checkable results"
          },
          "expect_minutes": {
            "type": "integer"
          },
          "todo_id": {
            "type": "string",
            "description": "your open to-do to join as a member"
          },
          "part_of": {
            "type": "string"
          }
        }
      }
    }
  }
}
