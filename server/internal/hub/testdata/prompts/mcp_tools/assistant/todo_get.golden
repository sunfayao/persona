{
  "name": "todo_get",
  "description": "Read a to-do's title/state, reminder and push status, timestamps, origin/plan, notes, agents, decisions and canonical repository/issue/PR associations. Maintain links with todo_links (add_links, or the revision-checked set and set_links); associations do not prove completion.",
  "input_schema": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "the to-do's id (todo_…), as todo_list gives it"
      }
    }
  }
}
