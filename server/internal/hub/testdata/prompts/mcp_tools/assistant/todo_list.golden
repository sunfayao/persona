{
  "name": "todo_list",
  "description": "List Persona to-dos (not Feishu tasks): open/failed starts by default, open first, then newest first. Returns id, title/state, project, reminder, agents and first note line; times use the user's time zone. Filter by the schema fields. Find an id here before edits; use todo_get for details.",
  "input_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "open",
          "done",
          "all"
        ],
        "description": "Default: open."
      },
      "with_agents": {
        "type": "boolean",
        "description": "true: with agents (tasks); false: user's own."
      },
      "query": {
        "type": "string",
        "description": "words to find in the title or notes"
      },
      "project": {
        "type": "string",
        "description": "Project label."
      },
      "kind": {
        "type": "string",
        "enum": [
          "todo",
          "concern"
        ],
        "description": "todo or user-raised concerns awaiting concern_report; omitted includes both."
      },
      "limit": {
        "type": "integer",
        "description": "Default 50; maximum 200."
      }
    }
  }
}
