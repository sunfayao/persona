{
  "name": "task_review",
  "description": "Record a verdict on a supervised task, judged on its scoped brief and criteria, not the Agent's claims.\n- accepted: outcome=done closes verified work. Give one met check with evidence per current done_when criterion.\n- rework: a concrete next step in note; accept with a note rather than bounce nitpicks.\n- parked: an outside wait, with reason, waiting_on and evidence.\n- needs_user: only what the owner alone can decide, with why_owner, reason, options, recommend and cost_of_waiting.\n- cancelled: duplicate or unwanted tasks only.\nOn another supervisor's task only accept or cancel; send gaps with agent_send.\n\nDetails: read .claude/skills/persona-work/references/task-review.md in your working directory.",
  "input_schema": {
    "type": "object",
    "required": [
      "todo_id",
      "verdict"
    ],
    "properties": {
      "todo_id": {
        "type": "string"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "accepted",
          "rework",
          "needs_user",
          "parked",
          "cancelled"
        ]
      },
      "rework_kind": {
        "type": "string",
        "enum": [
          "external_input",
          "substantive_new",
          "repeated_error",
          "low_roi_edge"
        ],
        "description": "external_input: not a stalled round; substantive_new: restarts the stalled count"
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "criterion",
            "met"
          ],
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string"
            }
          }
        }
      },
      "note": {
        "type": "string",
        "description": "in Simplified Chinese: the next step, the decision or the result"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "done",
          "cannot"
        ]
      },
      "reason": {
        "type": "string",
        "description": "one sentence in the owner's language"
      },
      "waiting_on": {
        "type": "string",
        "enum": [
          "someone_else",
          "external_event",
          "date"
        ]
      },
      "until": {
        "type": "string",
        "description": "3d, 36h or RFC 3339"
      },
      "link": {
        "type": "string"
      },
      "recommend": {
        "type": "string"
      },
      "why_owner": {
        "type": "string",
        "enum": [
          "irreversible",
          "visible_to_others",
          "priority",
          "acceptance",
          "only_owner_knows"
        ]
      },
      "options": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": [
            "label",
            "leads_to"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "leads_to": {
              "type": "string"
            }
          }
        }
      },
      "cost_of_waiting": {
        "type": "string"
      },
      "question_quote": {
        "type": "string",
        "description": "the Agent's question verbatim, if reason paraphrases it"
      },
      "can_wait": {
        "type": "boolean",
        "description": "next daily briefing instead of a push"
      },
      "deadline": {
        "type": "string",
        "description": "4h, 90m or RFC 3339; needs reversible"
      },
      "also_done": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string"
        }
      },
      "reversible": {
        "type": "boolean"
      },
      "evidence": {
        "type": "object",
        "required": [
          "kind",
          "target",
          "wake",
          "next_actor"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "person_reply",
              "merge_review",
              "external_event",
              "date"
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 200
          },
          "wake": {
            "type": "string",
            "maxLength": 600,
            "description": "the change that ends the wait"
          },
          "next_actor": {
            "type": "string",
            "enum": [
              "external",
              "owner"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "interaction_id": {
            "type": "string",
            "maxLength": 200
          },
          "pr_event": {
            "type": "string",
            "enum": [
              "terminal",
              "terminal_or_review"
            ]
          },
          "contact": {
            "type": "object",
            "required": [
              "channel",
              "url",
              "sender",
              "sent_at",
              "request",
              "status"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "maxLength": 2000
              },
              "sender": {
                "type": "string",
                "maxLength": 200
              },
              "sent_at": {
                "type": "string",
                "format": "date-time"
              },
              "request": {
                "type": "string",
                "maxLength": 600
              },
              "status": {
                "type": "string",
                "enum": [
                  "sent"
                ]
              }
            }
          },
          "ready": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "reply": {
            "type": "object",
            "required": [
              "source",
              "brand",
              "app_id",
              "account_open_id",
              "person_open_id",
              "chat_id",
              "thread_id",
              "request_message_id"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "larkcli"
                ]
              },
              "brand": {
                "type": "string",
                "enum": [
                  "feishu",
                  "lark"
                ]
              },
              "app_id": {
                "type": "string"
              },
              "account_open_id": {
                "type": "string"
              },
              "person_open_id": {
                "type": "string"
              },
              "chat_id": {
                "type": "string"
              },
              "thread_id": {
                "type": "string"
              },
              "request_message_id": {
                "type": "string"
              }
            },
            "description": "person_reply: exact lark-cli ids, not names"
          }
        }
      }
    }
  }
}
