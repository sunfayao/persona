{
  "name": "persona_settings",
  "description": "This is how the user changes Persona's settings: ask them in conversation, there is no settings page for these. `list` (the default) shows every key with a one-line description, how to set it and its current value (secrets only as set or unset); `get` reads one. `set`, `add` and `remove` show before → after as a confirmation card in Persona and change nothing until they approve; secrets are entered there, never in chat. Change only what was asked. Areas: assistant behavior, session triage, About Me, saved prompts, start page and sidebar, inbox sorting and task links, mail accounts, extensions (`extension.\u003cid\u003e`, channels and connectors too: its own switch, `enabled`, and its settings) and their download mirrors, hub updates, device notifications, each agent CLI's settings per computer and muted Claude config directories. Model profiles are not here: use `model_profiles`.\n\n`test` checks a provider ID for a `model_config.*` group, without approval or saving. `assistant.standing_authorizations`: never invent a quote or widen a grant's scope, and give only conditions that can be checked independently.\n\nDetails: read .claude/skills/persona-work/references/persona-settings.md in your working directory.",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "get",
          "set",
          "test",
          "add",
          "remove"
        ],
        "description": "default list"
      },
      "key": {
        "type": "string",
        "description": "the setting, from list"
      },
      "value": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "object",
          "array",
          "null"
        ],
        "description": "set: the new value; test: the provider ID to check; add: the item (each setting's list entry says what)"
      },
      "id": {
        "type": "string",
        "description": "remove: which item (from get)"
      }
    },
    "additionalProperties": false
  }
}
