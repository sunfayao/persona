{
  "name": "todo_create",
  "description": "Record what the user asks to remember, track or be reminded of (`remind`), and agreed work, immediately and without confirmation; carry the work out via task_plan, linking its task to this to-do (`todo_id` or `part_of`). Open title duplicates return existing to-dos but refuse bindings: use todo_links get and set. Short title in the user's language; details in notes. Bindings save atomically; IDs/catalog_revision from repositories list. No files or task progress changes.",
  "input_schema": {
    "type": "object",
    "required": [
      "title"
    ],
    "properties": {
      "title": {
        "type": "string",
        "description": "what is to be done, in a line, in the user's language"
      },
      "notes": {
        "type": "string",
        "description": "Details."
      },
      "remind": {
        "type": "string",
        "description": "Future reminder (user time zone/RFC3339 or relative 30m/2h/1d). Only when the user asks to be reminded."
      },
      "kind": {
        "type": "string",
        "enum": [
          "todo",
          "concern"
        ],
        "description": "todo (default); concern (main chat only) tracks a user-raised matter until its outcome is reported (todo_update); other completion tools cannot close it."
      },
      "project": {
        "type": "string",
        "description": "Project label; prefer long-term work. Only when clear; reuse an existing one, no near-duplicates."
      },
      "part_of": {
        "type": "string",
        "description": "Request to-do id this is a piece of; hand out via task_plan todo_id."
      },
      "after": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "With part_of: sibling piece ids it waits for."
      },
      "repository_bindings": {
        "type": "object",
        "required": [
          "catalog_revision",
          "repositories"
        ],
        "properties": {
          "catalog_revision": {
            "type": "integer",
            "minimum": 0
          },
          "repositories": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "repo_id"
              ],
              "properties": {
                "repo_id": {
                  "type": "string"
                },
                "directory_alias": {
                  "type": "string"
                },
                "requested_ref": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "default",
                        "branch",
                        "tag",
                        "commit",
                        "ref"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "default"
                        }
                      }
                    },
                    {
                      "required": [
                        "value"
                      ]
                    }
                  ]
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "issue",
                          "pull_request"
                        ]
                      },
                      "number": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,19}$"
                      },
                      "title": {
                        "type": "string",
                        "description": "Plain source title; trim; ≤1024 UTF-8 bytes.",
                        "maxLength": 1024
                      }
                    },
                    "additionalProperties": false,
                    "oneOf": [
                      {
                        "required": [
                          "url"
                        ],
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "kind"
                              ]
                            },
                            {
                              "required": [
                                "number"
                              ]
                            }
                          ]
                        }
                      },
                      {
                        "required": [
                          "kind",
                          "number"
                        ],
                        "not": {
                          "required": [
                            "url"
                          ]
                        }
                      }
                    ]
                  },
                  "maxItems": 50
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
