{
  "name": "todo_decision_add",
  "description": "Note a decision you made on your open todo. Use report_to_supervisor for progress and ask the user for decisions they own. Use supersedes_id to replace an earlier agent decision (see todo_decisions).",
  "input_schema": {
    "type": "object",
    "required": [
      "question",
      "choice"
    ],
    "properties": {
      "question": {
        "type": "string",
        "description": "what was to decide, in one line"
      },
      "choice": {
        "type": "string",
        "description": "what you chose"
      },
      "reason": {
        "type": "string",
        "description": "why, in a line or two"
      },
      "supersedes_id": {
        "type": "string",
        "description": "the earlier decision of this todo this one replaces"
      },
      "retry_key": {
        "type": "string",
        "description": "reuse the same key to retry one decision"
      }
    }
  }
}
