{
  "version": 1,
  "cases": [
    {
      "name": "message_taken",
      "description": "The to-do's Agent takes the message.",
      "source": [
        "server/internal/assistant/tasks_follow.go sendToTaskAgent"
      ],
      "input": {
        "route": "message",
        "what": "taken"
      },
      "expected": {
        "status": 200,
        "state": "delivered",
        "receipt": "done"
      }
    },
    {
      "name": "message_no_agent",
      "description": "The to-do has no Agent that can take it: refused before anything went out.",
      "source": [
        "server/internal/assistant/tasks_follow.go routeToTaskAs (route_no_agent)"
      ],
      "input": {
        "route": "message",
        "what": "no_agent"
      },
      "expected": {
        "status": 409,
        "code": "conflict",
        "delivered": "none",
        "state": "failed",
        "receipt": "failed"
      }
    },
    {
      "name": "message_not_this_conversation",
      "description": "The to-do is not this conversation's: refused before anything went out.",
      "source": [
        "server/internal/assistant/tasks_follow.go routeToTaskAs (route_no_task)"
      ],
      "input": {
        "route": "message",
        "what": "not_this_conversation"
      },
      "expected": {
        "status": 409,
        "code": "conflict",
        "delivered": "none",
        "state": "failed",
        "receipt": "failed"
      }
    },
    {
      "name": "message_refused",
      "description": "The Agent's computer refused the message with a code of its own and typed nothing.",
      "source": [
        "server/internal/assistant/todo_write_outcome.go writeDelivered (sendUnknown false)"
      ],
      "input": {
        "route": "message",
        "what": "refused"
      },
      "expected": {
        "status": 409,
        "code": "conflict",
        "delivered": "none",
        "state": "failed",
        "receipt": "failed"
      }
    },
    {
      "name": "message_not_sent",
      "description": "The send never left the manager.",
      "source": [
        "server/internal/assistant/todo_write_outcome.go writeDelivered (rpc.ErrNotSent)"
      ],
      "input": {
        "route": "message",
        "what": "not_sent"
      },
      "expected": {
        "status": 409,
        "code": "conflict",
        "delivered": "none",
        "state": "failed",
        "receipt": "failed"
      }
    },
    {
      "name": "message_in_doubt",
      "description": "The node's answer to the send never came back, so the message may have been typed.",
      "source": [
        "server/internal/assistant/todo_write_outcome.go writeDelivered (sendUnknown: startResultUnknown)"
      ],
      "input": {
        "route": "message",
        "what": "in_doubt"
      },
      "expected": {
        "status": 409,
        "code": "send_in_doubt",
        "delivered": "unknown",
        "state": "unknown",
        "receipt": "unknown"
      }
    },
    {
      "name": "message_node_not_sure",
      "description": "The node says typing stopped part way: the message may have arrived.",
      "source": [
        "server/internal/assistant/todo_write_outcome.go writeDelivered (sendUnknown: nodeMayHaveTaken)"
      ],
      "input": {
        "route": "message",
        "what": "node_not_sure"
      },
      "expected": {
        "status": 409,
        "code": "send_in_doubt",
        "delivered": "unknown",
        "state": "unknown",
        "receipt": "unknown"
      }
    },
    {
      "name": "message_start_in_doubt",
      "description": "Every Agent had stopped; the new Agent the message starts never answered its start, so it may have the message as its first.",
      "source": [
        "server/internal/assistant/tasks_follow.go routeToTaskAs",
        "server/internal/assistant/tasks_successor.go startTaskSuccessor"
      ],
      "input": {
        "route": "message",
        "what": "start_in_doubt"
      },
      "expected": {
        "status": 409,
        "code": "send_in_doubt",
        "delivered": "unknown",
        "state": "unknown",
        "receipt": "unknown"
      }
    },
    {
      "name": "message_start_refused",
      "description": "Every Agent had stopped; the new Agent's start was refused before it ran.",
      "source": [
        "server/internal/assistant/tasks_successor.go startTaskSuccessor"
      ],
      "input": {
        "route": "message",
        "what": "start_refused"
      },
      "expected": {
        "status": 409,
        "code": "conflict",
        "delivered": "none",
        "state": "failed",
        "receipt": "failed"
      }
    },
    {
      "name": "message_typed_then_not_kept",
      "description": "The Agent took the message, then the conversation's routed item could not be written.",
      "source": [
        "server/internal/assistant/tasks_follow.go sendToTaskAgent (wordsSent)"
      ],
      "input": {
        "route": "message",
        "what": "typed_then_not_kept"
      },
      "expected": {
        "status": 409,
        "code": "send_in_doubt",
        "delivered": "yes",
        "state": "unknown",
        "receipt": "unknown"
      }
    },
    {
      "name": "message_typed_then_deleted",
      "description": "The node took the message, then the Agent's conversation was marked deleted before the manager answered: the Agent has it.",
      "source": [
        "server/internal/assistant/service.go call (afterNodeWrite)"
      ],
      "input": {
        "route": "message",
        "what": "typed_then_deleted"
      },
      "expected": {
        "status": 409,
        "code": "send_in_doubt",
        "delivered": "yes",
        "state": "unknown",
        "receipt": "unknown"
      }
    },
    {
      "name": "message_start_then_not_kept",
      "description": "Every Agent had stopped; the new Agent started with the message as its first, then the conversation's routed item could not be written.",
      "source": [
        "server/internal/assistant/tasks_follow.go routeToTaskAs (wordsSent)"
      ],
      "input": {
        "route": "message",
        "what": "start_then_not_kept"
      },
      "expected": {
        "status": 409,
        "code": "send_in_doubt",
        "delivered": "yes",
        "state": "unknown",
        "receipt": "unknown"
      }
    }
  ]
}
