{
  "schema_version": 1,
  "cases": [
    {
      "name": "unified_conversation_plan_unlocked",
      "description": "核对对话页的可用动作、批准模式和解锁要求。",
      "source": [
        "docs/protocol/protocol.md §3.4、§5.3",
        "docs/protocol/protocol.md: Resolution",
        "docs/protocol/protocol.md §2.3、§4.2"
      ],
      "input": {
        "profile": "unified",
        "entry": "conversation",
        "kind": "plan",
        "locked": false
      },
      "expected": {
        "actions": [
          {
            "id": "approve_all",
            "authentication": "required",
            "requires_unlock": false,
            "available_now": true,
            "requirements": [
              "full_plan_read",
              "feedback_empty"
            ],
            "mode": "bypassPermissions"
          },
          {
            "id": "approve_edits",
            "authentication": "required",
            "requires_unlock": false,
            "available_now": true,
            "requirements": [
              "feedback_empty"
            ],
            "mode": "acceptEdits"
          },
          {
            "id": "approve_stepwise",
            "authentication": "required",
            "requires_unlock": false,
            "available_now": true,
            "requirements": [
              "feedback_empty"
            ],
            "mode": "default"
          },
          {
            "id": "reject",
            "authentication": "required",
            "requires_unlock": false,
            "available_now": true
          },
          {
            "id": "dismiss",
            "authentication": "required",
            "requires_unlock": false,
            "available_now": true
          }
        ]
      },
      "design_change": true
    },
