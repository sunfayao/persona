#!/bin/bash
# Refuse a push whose commits would bring private values (scripts/privacy_check.py --range): what each pushed branch
# adds on top of the tracked default branch, with the commit messages. Install: git config core.hooksPath scripts/hooks
# Compare branch updates with the previous remote tip, and new branches with the fork trunk.
set -eu
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
refused=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  from="$remote_sha"
  if [ "$from" = "$zero" ]; then
    from=$(git rev-parse --verify --quiet 'refs/remotes/origin/deploy^{commit}' ||
      git rev-parse --verify --quiet 'refs/heads/deploy^{commit}' || true)
  fi
  if [ -z "$from" ]; then
    echo "pre-push: cannot find a scan base for $local_ref (expected deploy)" >&2
    refused+=("$remote_ref")
    continue
  fi
  python3 "$root/scripts/privacy_check.py" --range "$from..$local_sha" </dev/null >&2 ||
    refused+=("$remote_ref")
done
if [ "${#refused[@]}" -gt 0 ]; then
  echo "pre-push: refused ${refused[*]}; see docs/operations/testing.md, \"Privacy scan\"" >&2
  exit 1
fi
